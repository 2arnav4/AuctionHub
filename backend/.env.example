PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/auction-room
# Selected explicitly, and overrides any database in MONGODB_URI. Without this,
# a connection string with no database segment silently resolves to "test".
MONGODB_DB_NAME=auction
AUCTION_ITEM_DURATION_SECONDS=30
# Set a unique, long value in production. Never commit the real secret.
JWT_SECRET=development-only-change-me
